# (b) No service uses .env, so no override is written. A COMPOSE_FILE built
# from a secret must still not reach compose, which would print a path it
# cannot open. secretref pins the compose file it found, with and without
# --all, and warns by name.
exec secretref run -- docker compose COMPOSE_FILE COMPOSE_PATH_SEPARATOR
stderr 'ignoring COMPOSE_FILE from an env file'
! grep 'SR_CANARY' child-env.txt
grep '^COMPOSE_FILE=.*compose\.yaml$' child-env.txt
no-canary
no-override

exec secretref run --all -- docker compose COMPOSE_FILE COMPOSE_PATH_SEPARATOR
stderr 'ignoring COMPOSE_FILE from an env file'
! grep 'SR_CANARY' child-env.txt
grep '^COMPOSE_FILE=.*compose\.yaml$' child-env.txt
no-canary
no-override

rm child-env.txt

# Without any compose file or -f, compose would read COMPOSE_FILE from .env
# itself and could expand it against the secret, so secretref refuses with
# exit 2, naming the variable and the env file only.
rm compose.yaml
exit-code 2 secretref run --all -- docker compose COMPOSE_FILE
stderr '^secretref: compose: COMPOSE_FILE is set in \.env but no compose file was found; pass -f or remove COMPOSE_FILE from the env file$'
! exists child-env.txt
no-canary

exit-code 2 secretref run -- docker compose COMPOSE_FILE
stderr '^secretref: compose: COMPOSE_FILE is set in \.env but no compose file was found; pass -f or remove COMPOSE_FILE from the env file$'
! exists child-env.txt
no-canary

-- .env --
# secretref: keyring://app/db_password
DB_PASSWORD=localdev
COMPOSE_FILE=x${DB_PASSWORD}
COMPOSE_PATH_SEPARATOR=,
-- compose.yaml --
services:
  web:
    image: alpine
