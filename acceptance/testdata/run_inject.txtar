# Plain and annotated variables from every provider reach the child, and
# secretref prints nothing.
exec secretref run -- printenv-helper PLAIN DB_PASSWORD API_KEY AWS_PASSWORD
! stdout .
! stderr .
no-canary
grep '^PLAIN=hello$' child-env.txt
grep '^DB_PASSWORD=SR_CANARY_7f3a9c$' child-env.txt
grep '^API_KEY=SR_CANARY_7f3a9c$' child-env.txt
grep '^AWS_PASSWORD=SR_CANARY_7f3a9c$' child-env.txt

# --verbose names keys and refs on stderr, never values.
exec secretref run --verbose -- printenv-helper DB_PASSWORD
stderr 'resolved DB_PASSWORD from keyring://app/db_password'
! stderr 'resolved PLAIN'
no-canary

-- .env --
PLAIN=hello
# secretref: keyring://app/db_password
DB_PASSWORD=localdev
# secretref: gcp-sm://my-project/api-key
API_KEY=dev-key
# secretref: aws-sm://eu-west-1/prod/db#password
AWS_PASSWORD=dev
