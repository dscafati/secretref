# ${VAR} expands to the resolved value in unquoted and double-quoted values,
# not in single-quoted ones. Values built from a resolved key are injected by
# default; the others only with --all.
exec secretref run -- printenv-helper DATABASE_URL QUOTED LITERAL
grep '^DATABASE_URL=postgres://app:SR_CANARY_7f3a9c@db/app$' child-env.txt
grep '^QUOTED=pw=SR_CANARY_7f3a9c;$' child-env.txt
grep '^LITERAL unset$' child-env.txt
no-canary

# A bare $VAR is literal and $$ is a literal $.
exec secretref run --all -- printenv-helper LITERAL BARE DOLLARS
grep '^LITERAL=\$\{DB_PASSWORD\}$' child-env.txt
grep '^BARE=abc\$DB_PASSWORD$' child-env.txt
grep '^DOLLARS=pa\$word$' child-env.txt
no-canary

-- .env --
# secretref: keyring://app/db_password
DB_PASSWORD=localdev
DATABASE_URL=postgres://app:${DB_PASSWORD}@db/app
QUOTED="pw=${DB_PASSWORD};"
LITERAL='${DB_PASSWORD}'
BARE=abc$DB_PASSWORD
DOLLARS=pa$$word
