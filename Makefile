# Tool versions live in tools/go.mod. Never install tools globally.
GO       ?= go
TOOL     := $(GO) tool -modfile=tools/go.mod
CONTAINER ?= podman
FUZZTIME ?= 30s

.DEFAULT_GOAL := check
.PHONY: check hooks scripts-check doc-go-check reveal-check fix fmt-check lint tidy-check test test-acceptance fuzz test-integration build-all docs docs-check adr-index adr-check skills-check snapshot

# Every release target. Keep in sync with builds[].goos/goarch in .goreleaser.yaml.
BUILD_TARGETS := linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64 windows/arm64

check: fmt-check lint tidy-check test test-acceptance docs-check adr-check skills-check doc-go-check scripts-check reveal-check

# Installs the git hooks from lefthook.yml. Run once per clone.
hooks:
	$(TOOL) lefthook install

fmt-check:
	@out=$$($(TOOL) gofumpt -l .); \
	if [ -n "$$out" ]; then echo "gofumpt needed on:"; echo "$$out"; exit 1; fi

lint:
	$(TOOL) golangci-lint run ./...

tidy-check:
	$(GO) mod tidy -diff
	cd tools && $(GO) mod tidy -diff

fix:
	$(TOOL) gofumpt -l -w .
	$(TOOL) golangci-lint run --fix ./...

# Unit and golden tests only. Suites behind the acceptance and integration build
# tags are excluded because plain `go test` ignores tagged files.
test:
	$(GO) test -race ./...

# Acceptance tests drive the real binary through testscript. They live in
# ./acceptance behind the `acceptance` build tag.
test-acceptance:
	@if [ -d acceptance ]; then $(GO) test -race -count=1 -tags acceptance ./acceptance/...; \
	else echo "test-acceptance: no acceptance directory yet, skipping"; fi

# Minimization is off (-fuzzminimizetime 0): when -fuzztime expires while a worker
# is minimizing an input, go test fails with "context deadline exceeded" instead
# of passing, which made CI flaky. A crasher is still saved, just unminimized.
# Runs every Fuzz* target in ./internal/envfile and ./internal/ref for
# $(FUZZTIME) each. Fails if a package does not build or has no Fuzz target, so
# a broken list never passes as "nothing to fuzz".
fuzz:
	@for pkg in envfile ref; do \
	  if ! list=$$($(GO) test -list '^Fuzz' ./internal/$$pkg 2>&1); then \
	    echo "fuzz: go test -list failed for internal/$$pkg:"; echo "$$list"; exit 1; \
	  fi; \
	  targets=$$(printf '%s\n' "$$list" | awk '/^Fuzz/'); \
	  if [ -z "$$targets" ]; then echo "fuzz: no Fuzz targets in internal/$$pkg"; exit 1; fi; \
	  for t in $$targets; do \
	    echo "fuzz $$pkg $$t"; \
	    $(GO) test ./internal/$$pkg -run '^$$' -fuzz "^$$t$$" -fuzztime $(FUZZTIME) -fuzzminimizetime 0 || exit 1; \
	  done; \
	done

# Integration tests live in internal/provider/... behind the `integration` build
# tag. The script starts the Moto Secrets Manager emulator with $(CONTAINER)
# (podman or docker) and, on Linux with gnome-keyring, a throwaway Secret
# Service, then removes both. CI runs the same target with CONTAINER=docker.
test-integration:
	CONTAINER=$(CONTAINER) GO=$(GO) bash scripts/test-integration.sh

# Proves the CGO_ENABLED=0 invariant: cross-compiles ./cmd/secretref for every
# release target. `make test` cannot, because -race needs cgo. Binaries go to a
# temporary directory that is always removed.
build-all:
	@out=$$(mktemp -d); trap 'rm -rf "$$out"' EXIT; \
	for t in $(BUILD_TARGETS); do \
	  os=$${t%/*}; arch=$${t#*/}; \
	  echo "build-all: $$os/$$arch"; \
	  CGO_ENABLED=0 GOOS=$$os GOARCH=$$arch $(GO) build -trimpath -o "$$out/secretref-$$os-$$arch" ./cmd/secretref || exit 1; \
	done

docs: adr-index
	@if [ -d cmd/gen-docs ]; then $(GO) run ./cmd/gen-docs; \
	else echo "docs: cmd/gen-docs not present yet, skipping"; fi

# Fails on modified or untracked files under docs/reference. dist-docs/man and
# dist-docs/completions are generated by `make docs` too, but are gitignored and
# not checked here. GoReleaser expects dist-docs/man/* and
# dist-docs/completions/secretref.{bash,zsh,fish}.
docs-check:
	@if [ -d cmd/gen-docs ]; then \
	  $(GO) run ./cmd/gen-docs && git diff --exit-code docs/reference && \
	  if [ -n "$$(git status --porcelain docs/reference)" ]; then \
	    echo "docs/reference has untracked or uncommitted changes:"; git status --porcelain docs/reference; exit 1; fi; \
	else echo "docs-check: cmd/gen-docs not present yet, skipping"; fi

adr-index:
	sh scripts/gen-adr-index.sh > docs/decisions/index.md

adr-check:
	@if [ -f scripts/check-adr-index.sh ]; then sh scripts/check-adr-index.sh; \
	else echo "adr-check: scripts/check-adr-index.sh not present yet, skipping"; fi

reveal-check:
	@sh scripts/check-reveal.sh

skills-check:
	sh scripts/check-skills-link.sh

# Every Go package has a doc.go.
doc-go-check:
	sh scripts/check-doc-go.sh

# Tests the commit-message check and the Claude Code git guard.
scripts-check:
	sh scripts/test-commit-checks.sh

# Local snapshot of every artifact and package-manager manifest. Signing and
# SBOMs need cosign and syft on PATH, so they are skipped here; the release
# workflow's dry run (workflow_dispatch) exercises them.
snapshot:
	$(TOOL) goreleaser release --snapshot --clean --skip=sign,sbom
